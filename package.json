{
  "name": "seamless-banking",
  "version": "1.0.0",
  "private": true,
  "description": "Прототип бесшовного перехода (Seamless Handoff) между веб- и мобильным банковским приложением",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node apps/api/src/server.js",
    "dev": "node --watch apps/api/src/server.js",
    "test": "node --test --test-reporter=spec \"tests/*.test.mjs\"",
    "smoke": "node tests/smoke.mjs",
    "test:e2e": "node --test --test-reporter=spec \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  }
}
